# ---- Banco de dados (WAMP / MySQL) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=curso_erick

# ---- Seguranca ----
# gere com: npm run jwt:secret  (ou cole uma string longa e aleatoria)
JWT_SECRET=
JWT_EXPIRES=7d

# ---- Admin criado pelo seed ----
ADMIN_NAME=Erick Administrador
ADMIN_EMAIL=admin@nomadeface.com
ADMIN_PHONE=(11) 90000-0000
# defina uma senha forte aqui antes de rodar o seed, ou rode: npm run senha:admin
ADMIN_PASSWORD=

# ---- Uploads ----
# pasta onde os videos ficam guardados (fora da pasta publica)
VIDEO_STORAGE_DIR=./storage/videos

# limite de tamanho dos envios (MB)
MAX_VIDEO_MB=2048
MAX_COVER_MB=10

NEXT_PUBLIC_SITE_NAME=NomadeFace
